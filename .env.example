# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Your private key (for deployment to testnets/mainnet)
PRIVATE_KEY=your_private_key_here

# RPC URLs (optional - defaults provided)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_MAINNET_RPC_URL=https://rpc-mainnet.polygon.network

# Optional: Custom RPC URLs
# ETHEREUM_MAINNET_RPC_URL=https://eth.llamarpc.com
# ETHEREUM_SEPOLIA_RPC_URL=https://rpc-sepolia.etherscan.com